{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": [ "node", "mocha" ],
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": [ "ES2024" ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },

  "include": [
    "types/*.d.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.js",
    "eslint.config.mjs"
  ],

  "typedocOptions": {
    "name": "Tedious",
    "out": "./docs",
    "entryPoints": ["./src/tedious.ts"],
    "customCss": "./typedoc-assets/theme.css",
    "customJs": "./typedoc-assets/dark-mode.js",
    "plugin": ["./typedoc-assets/theme.mjs"],
    "navigationLinks": {
      "GitHub": "https://github.com/tediousjs/tedious",
      "Examples": "https://github.com/tediousjs/tedious/tree/master/examples",
      "Changelog": "https://github.com/tediousjs/tedious/releases"
    },
    "highlightLanguages": ["js", "ts", "json", "sh", "sql"],
    "externalSymbolLinkMappings": {
      "typescript": {
        "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
        "Iterable": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Iteration_protocols#the_iterable_protocol",
        "AsyncIterable": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Iteration_protocols#the_async_iterator_and_async_iterable_protocols"
      }
    }
  }
}
